<ui:FluentWindow
    x:Class="ZapretDesktop.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:ZapretDesktop.Desktop.Converters"
    Title="Zapret Desktop"
    Width="1050"
    Height="800"
    MinWidth="920"
    MinHeight="680"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <converters:BooleanToStartStopConverter x:Key="BooleanToStartStopConverter" />
        <converters:BooleanInverterConverter x:Key="BooleanInverterConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:SuccessRateToBrushConverter x:Key="SuccessRateToBrushConverter" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Zapret Desktop">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        x:Name="ThemeButton"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon DarkTheme24}"
                        ToolTip="Сменить тему" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="12,0,12,12">

            <!-- ================= Обход ================= -->
            <TabItem Header="Обход">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Статус обхода" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="{Binding StatusText}"
                                TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:ToggleSwitch
                                    Margin="0,0,12,0"
                                    Content="Обход DPI"
                                    Focusable="False"
                                    IsChecked="{Binding IsRunning, Mode=OneWay}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource BooleanInverterConverter}}"
                                    IsHitTestVisible="False"
                                    ToolTip="Индикатор состояния. Запуск и остановка — кнопкой справа." />
                                <ui:Button
                                    Appearance="Primary"
                                    Command="{Binding ToggleServiceCommand}"
                                    Content="{Binding IsRunning, Converter={StaticResource BooleanToStartStopConverter}, FallbackValue='Запустить'}"
                                    Icon="{ui:SymbolIcon Play24}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource BooleanInverterConverter}}" />
                            </StackPanel>

                            <WrapPanel Margin="0,10,0,0">
                                <ui:TextBlock
                                    Margin="0,0,18,4"
                                    Appearance="Secondary"
                                    Text="{Binding EngineVersion, StringFormat='Движок: {0}'}" />
                                <ui:TextBlock
                                    Margin="0,0,18,4"
                                    Appearance="Secondary"
                                    Text="{Binding IsAdmin, StringFormat='Права администратора: {0}'}" />
                                <ui:TextBlock
                                    Margin="0,0,18,4"
                                    Appearance="Secondary"
                                    Text="{Binding IsInstalled, StringFormat='winws найден: {0}'}" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Стратегия" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="Все стратегии в одном списке. Можно проверить их автоматически на вкладке «Автоподбор»."
                                TextWrapping="Wrap" />

                            <ComboBox
                                Margin="0,10,0,8"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding Presets}"
                                SelectedItem="{Binding SelectedPreset}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{Binding Description}"
                                                FontSize="11"
                                                Foreground="Gray"
                                                TextWrapping="Wrap"
                                                MaxWidth="700" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ui:TextBlock
                                Margin="0,0,0,6"
                                Appearance="Secondary"
                                Text="{Binding SelectedPreset.Description}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="2" Margin="0,0,0,10">
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Быстрые действия" />
                            <ui:TextBlock Appearance="Secondary" Text="Проверка и обслуживание" />

                            <WrapPanel Margin="0,8,0,0">
                                <ui:Button
                                    Margin="0,0,8,8"
                                    Appearance="Secondary"
                                    Command="{Binding TestSelectedPresetCommand}"
                                    Content="Проверить выбранную"
                                    Icon="{ui:SymbolIcon Checkmark24}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource BooleanInverterConverter}}" />
                                <ui:Button
                                    Margin="0,0,8,8"
                                    Appearance="Secondary"
                                    Command="{Binding CancelAutoTestCommand}"
                                    Content="Отменить тест"
                                    Icon="{ui:SymbolIcon Stop24}"
                                    Visibility="{Binding IsTesting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ui:Button
                                    Margin="0,0,8,8"
                                    Appearance="Secondary"
                                    Command="{Binding OpenLogsFolderCommand}"
                                    Content="Папка логов"
                                    Icon="{ui:SymbolIcon Folder24}" />
                                <ui:Button
                                    Margin="0,0,8,8"
                                    Appearance="Secondary"
                                    Command="{Binding OpenListsFolderCommand}"
                                    Content="Папка списков"
                                    Icon="{ui:SymbolIcon DocumentFolder24}" />
                                <ui:Button
                                    Margin="0,0,8,8"
                                    Appearance="Secondary"
                                    Command="{Binding ClearLogCommand}"
                                    Content="Очистить лог"
                                    Icon="{ui:SymbolIcon Delete24}" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="3">
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Лог" />
                            <ui:TextBlock Appearance="Secondary" Text="Вывод winws и сообщения приложения" />

                            <TextBox
                                Height="128"
                                Margin="0,8,0,0"
                                FontFamily="Consolas"
                                FontSize="11"
                                IsReadOnly="True"
                                Text="{Binding LogText}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- ================= Автоподбор ================= -->
            <TabItem Header="Автоподбор">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Автоматический подбор стратегии" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="Приложение по очереди запускает каждую стратегию, проверяет Discord, YouTube, Telegram и Google, измеряет задержку и оставляет лучшую."
                                TextWrapping="Wrap" />

                            <WrapPanel Margin="0,8,0,0">
                                <ui:Button
                                    Margin="0,0,8,8"
                                    Appearance="Primary"
                                    Command="{Binding RunAutoTestCommand}"
                                    Content="Начать подбор"
                                    Icon="{ui:SymbolIcon Play24}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource BooleanInverterConverter}}" />
                                <ui:Button
                                    Margin="0,0,8,8"
                                    Appearance="Secondary"
                                    Command="{Binding CancelAutoTestCommand}"
                                    Content="Остановить"
                                    Icon="{ui:SymbolIcon Stop24}"
                                    IsEnabled="{Binding IsTesting}" />
                            </WrapPanel>

                            <ProgressBar
                                Height="6"
                                Margin="0,8,0,4"
                                Maximum="100"
                                Value="{Binding TestProgress}" />

                            <ui:TextBlock Appearance="Secondary" Text="{Binding TestProgressText}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="1" Margin="0,0,0,10">
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Результаты" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="✅ — стратегия рабочая, ❌ — нет доступа. Время — средний отклик HTTP по доступным целям, а не ping в Discord."
                                TextWrapping="Wrap" />

                            <ListBox Height="200" Margin="0,8,0,0" ItemsSource="{Binding TestResults}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="270" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontWeight="SemiBold"
                                                Text="{Binding Preset.Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding PassedUrls, StringFormat={}{0} целей}" />
                                            <TextBlock Grid.Column="3" Text="{Binding LatencyMs, StringFormat=отклик {0} мс}" />
                                            <TextBlock
                                                Grid.Column="4"
                                                Foreground="Gray"
                                                Text="{Binding Details}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="2">
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Журнал проверки" />
                            <ui:TextBlock Appearance="Secondary" Text="Подробности по каждой стратегии" />

                            <TextBox
                                Height="138"
                                Margin="0,8,0,0"
                                FontFamily="Consolas"
                                FontSize="11"
                                IsReadOnly="True"
                                Text="{Binding TestLog}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- ================= Telegram ================= -->
            <TabItem x:Name="TelegramTab" Header="Telegram">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ui:Card Margin="0,0,0,10">
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="Прокси для Telegram" />
                                <ui:TextBlock
                                    Appearance="Secondary"
                                    Text="Нажмите «Подобрать прокси» — приложение само скачает свежий список MTProto-прокси, проверит скорость и выберет лучший. Боты и сайты не нужны."
                                    TextWrapping="Wrap" />

                                <WrapPanel Margin="0,8,0,0">
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        Appearance="Primary"
                                        Command="{Binding FindProxiesCommand}"
                                        Content="Подобрать прокси"
                                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                                        IsEnabled="{Binding IsLoadingProxies, Converter={StaticResource BooleanInverterConverter}}" />
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        Appearance="Secondary"
                                        Command="{Binding TestTelegramCommand}"
                                        Content="Проверить Telegram"
                                        Icon="{ui:SymbolIcon Checkmark24}"
                                        IsEnabled="{Binding IsTesting, Converter={StaticResource BooleanInverterConverter}}" />
                                </WrapPanel>

                                <ProgressBar
                                    Height="4"
                                    Margin="0,4,0,6"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsLoadingProxies, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <ComboBox
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding IsLoadingProxies, Converter={StaticResource BooleanInverterConverter}}"
                                    ItemsSource="{Binding Proxies}"
                                    SelectedItem="{Binding SelectedProxy}"
                                    ToolTip="Чем меньше задержка — тем быстрее прокси">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding HostPort}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="12,0,0,0"
                                                    Foreground="Gray"
                                                    Text="{Binding LatencyMs, StringFormat=TCP {0} мс}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <WrapPanel Margin="0,8,0,0">
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        Appearance="Primary"
                                        Command="{Binding OpenTelegramProxyLinkCommand}"
                                        Content="Подключить в Telegram"
                                        Icon="{ui:SymbolIcon Send24}" />
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        Appearance="Secondary"
                                        Command="{Binding CopyTelegramProxyLinkCommand}"
                                        Content="Скопировать ссылку"
                                        Icon="{ui:SymbolIcon Copy24}" />
                                </WrapPanel>

                                <TextBox
                                    MinHeight="72"
                                    Margin="0,2,0,0"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    IsReadOnly="True"
                                    Text="{Binding TelegramStatus}"
                                    TextWrapping="Wrap" />

                                <ui:TextBlock
                                    Margin="0,8,0,0"
                                    Appearance="Secondary"
                                    FontSize="11"
                                    Text="После нажатия «Подключить в Telegram» откроется Telegram с предложением включить прокси — подтвердите подключение. Прокси публичные: если один перестал работать, нажмите «Подобрать прокси» ещё раз."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card>
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="Свой прокси (необязательно)" />
                                <ui:TextBlock
                                    Appearance="Secondary"
                                    Text="Обычно ничего вводить не нужно — используйте автоподбор выше. Раздел для собственного MTProto-прокси."
                                    TextWrapping="Wrap" />

                                <Expander Header="Ввести вручную" Margin="0,8,0,0">
                                    <StackPanel>
                                <Grid Margin="0,10,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ui:TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" Text="Сервер" />
                                    <ui:TextBlock Grid.Row="0" Grid.Column="1" Margin="8,0,0,4" Text="Порт" />

                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Text="{Binding TelegramProxyHost, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Например: proxy.example.com" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding TelegramProxyPort, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <ui:TextBlock Margin="0,0,0,4" Text="Секрет" />
                                <TextBox
                                    Margin="0,0,0,8"
                                    Text="{Binding TelegramProxySecret, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="32/34 hex-символа, длинный FakeTLS-секрет или base64" />

                                <WrapPanel Margin="0,0,0,8">
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        Appearance="Primary"
                                        Command="{Binding SaveTelegramProxyCommand}"
                                        Content="Сохранить"
                                        Icon="{ui:SymbolIcon Save24}" />
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        Appearance="Secondary"
                                        Command="{Binding CopyTelegramProxyLinkCommand}"
                                        Content="Скопировать ссылку"
                                        Icon="{ui:SymbolIcon Copy24}" />
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        Appearance="Secondary"
                                        Command="{Binding OpenTelegramProxyLinkCommand}"
                                        Content="Открыть в Telegram"
                                        Icon="{ui:SymbolIcon Link24}" />
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        Appearance="Secondary"
                                        Command="{Binding OpenConfigFolderCommand}"
                                        Content="Папка настроек"
                                        Icon="{ui:SymbolIcon Folder24}" />
                                </WrapPanel>

                                <ui:TextBlock Margin="0,0,0,4" Appearance="Secondary" Text="Ссылка для Telegram:" />
                                <TextBox IsReadOnly="True" Text="{Binding TelegramProxyLink}" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Списки ================= -->
            <TabItem Header="Списки">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:Card Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Списки доменов и IP" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="list-general-user.txt — свои сайты, list-exclude-user.txt — исключения. Один домен на строку."
                                TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                                <ComboBox
                                    Width="260"
                                    Margin="0,0,8,0"
                                    ItemsSource="{Binding ListFiles}"
                                    SelectedItem="{Binding SelectedListFile}" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Appearance="Secondary"
                                    Command="{Binding ReloadListCommand}"
                                    Content="Перечитать"
                                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
                                <ui:Button
                                    Margin="0,0,8,0"
                                    Appearance="Primary"
                                    Command="{Binding SaveListCommand}"
                                    Content="Сохранить"
                                    Icon="{ui:SymbolIcon Save24}" />
                                <ui:Button
                                    Appearance="Secondary"
                                    Command="{Binding OpenListsFolderCommand}"
                                    Content="Открыть папку"
                                    Icon="{ui:SymbolIcon Folder24}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    Grid.Column="0"
                                    Height="250"
                                    Margin="0,0,8,0"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    HorizontalScrollBarVisibility="Auto"
                                    Text="{Binding ListContent, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="NoWrap"
                                    VerticalScrollBarVisibility="Auto" />

                                <StackPanel Grid.Column="1" Width="250">
                                    <ui:TextBlock Margin="0,0,0,4" Text="Добавить сайт" />
                                    <TextBox
                                        x:Name="DomainInput"
                                        Margin="0,0,0,8"
                                        Text="{Binding DomainsToAdd, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Введите домен и нажмите Enter — он сразу запишется в list-general-user.txt"
                                        VerticalContentAlignment="Center" />
                                    <ui:Button
                                        Appearance="Primary"
                                        Command="{Binding AddDomainsCommand}"
                                        Content="Добавить"
                                        Icon="{ui:SymbolIcon Add24}" />
                                    <ui:TextBlock
                                        Margin="0,8,0,0"
                                        Appearance="Secondary"
                                        FontSize="11"
                                        Text="Введите домен (например, rutracker.org) и нажмите Enter — он автоматически добавится в list-general-user.txt. Можно вставить несколько через пробел или запятую. Если обход запущен — он перезапустится сам."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Grid.Row="1">
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Как это работает" />
                            <ui:TextBlock
                                Appearance="Secondary"
                                Text="Стратегии берут домены из list-general.txt / list-google.txt, а ваши сайты — из list-general-user.txt. Исключения (банки, госуслуги) не обрабатываются."
                                TextWrapping="Wrap" />
                            <ui:TextBlock
                                Margin="0,4,0,0"
                                Appearance="Secondary"
                                Text="Списки лежат в папке lists рядом с программой. После сохранения обход перезапускается автоматически."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- ================= Настройки ================= -->
            <TabItem Header="Настройки">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ui:Card Margin="0,0,0,10">
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="Поведение приложения" />
                                <ui:TextBlock Appearance="Secondary" Text="Трей, автозапуск и старт обхода" />

                                <ui:ToggleSwitch
                                    Margin="0,8,0,2"
                                    Content="Сворачивать в системный трей (окно не висит на панели задач)"
                                    IsChecked="{Binding MinimizeToTray}" />
                                <ui:ToggleSwitch
                                    Margin="0,2"
                                    Content="Запускать свёрнутым в трей"
                                    IsChecked="{Binding StartMinimized}" />
                                <ui:ToggleSwitch
                                    Margin="0,2"
                                    Content="Автозапуск вместе с Windows"
                                    IsChecked="{Binding AutoStartWithWindows}" />
                                <ui:ToggleSwitch
                                    Margin="0,2"
                                    Content="Автоматически включать обход при старте приложения"
                                    IsChecked="{Binding AutoStartZapret}" />

                                <ui:TextBlock
                                    Margin="0,6,0,0"
                                    Appearance="Secondary"
                                    FontSize="11"
                                    Text="Настройки сохраняются автоматически. winws работает без окна и не отображается на панели задач."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,0,10">
                            <StackPanel>
                                <ui:TextBlock FontTypography="BodyStrong" Text="Движок winws" />
                                <ui:TextBlock Appearance="Secondary" Text="Параметры обхода и диагностика" />

                                <ui:ToggleSwitch
                                    Margin="0,8,0,2"
                                    Content="Вести лог в файл (logs\zapret-ГГГГ-ММ-ДД.log)"
                                    IsChecked="{Binding EnableLogging}" />
                                <ui:ToggleSwitch
                                    Margin="0,2"
                                    Content="Игровой фильтр: обход всех портов 1024-65535"
                                    IsChecked="{Binding GameFilter}" />
                                <ui:TextBlock
                                    Margin="0,2,0,8"
                                    Appearance="Secondary"
                                    FontSize="11"
                                    Text="{Binding GameFilterHint}"
                                    TextWrapping="Wrap" />

                                <WrapPanel>
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        Appearance="Secondary"
                                        Command="{Binding OpenBinFolderCommand}"
                                        Content="Папка winws"
                                        Icon="{ui:SymbolIcon Folder24}" />
                                    <ui:Button
                                        Margin="0,0,8,8"
                                        Appearance="Secondary"
                                        Command="{Binding OpenLogsFolderCommand}"
                                        Content="Логи"
